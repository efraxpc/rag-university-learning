# Copia este fichero a .env y rellena los valores. .env está en .gitignore.

# API key de Gemini (free tier de AI Studio): https://aistudio.google.com/apikey
GEMINI_API_KEY=pega-aqui-tu-clave

# Modelos de la Gemini API.
EMBEDDING_MODEL=gemini-embedding-001
GEN_MODEL=gemini-2.5-flash
# Modelo de conocimiento general: complementa la respuesta RAG cuando el tema
# está en los documentos y responde solo cuando no está. Si no está disponible
# se cae a GEN_MODEL.
GENERAL_MODEL=gemini-3.1-pro-preview
# Umbral de distancia coseno: si el mejor match lo supera, se considera que la
# respuesta NO está en el RAG y se responde solo con conocimiento general.
MAX_DISTANCE=0.6

# Dimensión de salida de los embeddings (output_dimensionality, Matryoshka).
# Debe coincidir con vector(N) de scripts/init_db.sql.
# OJO: pgvector limita los índices HNSW/IVFFlat a 2000 dims → 1536 es el
# máximo seguro recomendado (aunque el modelo soporte 3072).
EMBEDDING_DIMS=1536

# Optimización pre-retrieval: small-to-big + ventana deslizante.
# true  → se vectorizan chunks pequeños (precisión) y se devuelve el parent
#         grande (contexto) al LLM.
# false → modo clásico: se vectorizan los chunks de PARENT_CHUNK_SIZE.
# Tamaños en caracteres: tamaño/solape de la ventana deslizante.
SMALL_TO_BIG=true
PARENT_CHUNK_SIZE=1024
PARENT_CHUNK_OVERLAP=128
SMALL_CHUNK_SIZE=256
SMALL_CHUNK_OVERLAP=50

# Optimizaciones pre-retrieval del lado de la consulta:
# QUERY_REWRITE → el LLM reescribe la pregunta antes de buscar.
# QUERY_EXPANSION → multi-query: el LLM genera variantes parafraseadas y se
#                   busca con todas, fusionando resultados por parent (min distancia).
# Ambas se hacen en UNA llamada al LLM; la generación usa la pregunta ORIGINAL.
# Debug en logs: api.log muestra original → reescrita + variantes.
QUERY_REWRITE=true
QUERY_EXPANSION=true
EXPANSION_VARIANTS=3

# Base de datos para ejecuciones locales manuales (sin local-test.sh).
# Apunta al pgvector en Docker; descomenta si ejecutas uvicorn/chunker a mano.
#DATABASE_URL=postgresql+pg8000://app:app@127.0.0.1:55432/ragdb
