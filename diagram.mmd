flowchart LR
    U([Usuario]) -->|"kubectl port-forward<br/>(sin Load Balancer)"| FE

    subgraph GKE["GKE Autopilot (regional, sin GPU)"]
        FE["Next.js UI<br/>chat + subida de docs<br/>resumen multi-clase (checkboxes)"]
        API["FastAPI orquestador<br/>/documents · /query<br/>retrieval · prompt augmentation · sanity checks"]
        JOB["K8s Job de chunking (Spot)<br/>extraer → limpiar → trocear"]
        FUSE[/"GCS FUSE CSI<br/>mount del bucket"/]
    end

    subgraph GCP["Servicios gestionados GCP"]
        GCS[("Cloud Storage<br/>documentos crudos")]
        DB[("Cloud SQL PostgreSQL + pgvector<br/>IP privada · índice HNSW")]
        SM["Secret Manager<br/>API keys (Gemini · Anthropic)<br/>password DB"]
        GEM["Gemini API<br/>SOLO embeddings<br/>AI Studio free tier → Vertex AI"]
        OBS["Cloud Logging + Monitoring<br/>+ Query Insights"]
    end

    LLM["Anthropic Claude (generación)<br/>patrón Strategy por LLM_PROVIDER:<br/>API directa (default) ·<br/>Vertex AI Model Garden<br/>Fable 5 (respuestas) · Haiku 4.5 (auxiliar)"]

    %% Flujo A: ingesta (bajo demanda)
    FE -->|"POST /documents"| API
    API -->|"1. guarda doc crudo"| GCS
    API -->|"2. registra metadata (pending)"| DB
    API -->|"3. crea Job"| JOB
    JOB --- FUSE
    FUSE -->|"4. lee doc"| GCS
    JOB -->|"5. vectoriza chunks"| GEM
    JOB -->|"6. inserta chunks + vectores (ready)"| DB

    %% Flujo B: consulta (tiempo real)
    FE -->|"POST /query"| API
    API -->|"7. embed de la pregunta"| GEM
    API -->|"8. búsqueda híbrida top-k<br/>HNSW + filtros metadata"| DB
    DB -->|"chunks + fuentes"| API
    API -->|"9. prompt aumentado"| LLM
    LLM -->|"10. respuesta generada"| API
    API -->|"11. respuesta verificada + citas"| FE

    %% Transversal
    API -->|"lee secretos"| SM
    JOB -->|"lee secretos"| SM
    GKE -.->|"Workload Identity"| GCS
    GKE -.->|"logs y métricas"| OBS
